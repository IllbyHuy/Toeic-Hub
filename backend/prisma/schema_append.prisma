
model Topic {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  words       SystemVocab[]
  
  @@map("topics")
}

model SystemVocab {
  id            String   @id @default(cuid())
  topicId       String
  word          String
  pronunciation String?
  type          String?
  meaning       String
  audioUrl      String?
  example       String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  progresses    UserVocabProgress[]

  @@index([topicId])
  @@map("system_vocabs")
}

model UserVocabProgress {
  id            String   @id @default(cuid())
  userId        String
  systemVocabId String
  status        VocabStatus @default(LEARNING)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocab         SystemVocab @relation(fields: [systemVocabId], references: [id], onDelete: Cascade)

  @@unique([userId, systemVocabId])
  @@index([userId])
  @@index([systemVocabId])
  @@map("user_vocab_progress")
}

enum VocabStatus {
  LEARNING
  MASTERED
}
